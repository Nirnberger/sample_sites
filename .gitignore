# Build-Ergebnisse (werden auf dem Server neu erzeugt)
public/
lighthouse-berichte/
**/dist/
.bildcache/
**/.bildcache/
**/vorschau/
node_modules/
**/__pycache__/

# Vertriebsdaten und Caches – nicht ins Website-Repository
leads_*.csv
.lead_cache/
**/lead_auswertung_*/lh_ergebnisse.json

# Persönliche Vertriebsnotizen
pitches/

# Lokale Claude-Code-Einstellungen
.claude/settings.local.json

# Kundenrecherche (personenbezogene Daten, fremde Fotos)
recherche/

# Videos nie ins Repository (zu groß; Showreels später über Objektspeicher)
*.mp4
*.m4v
*.mov
*.webm
*.avi
*.mkv
*.wmv
*.mpg
*.mpeg

# Kundenfotos und -medien liegen im Objektspeicher (scripts/medien.js), nie in Git
kunden/*/images/*
!kunden/*/images/LIESMICH.md
kunden/*/medien/

# Lokale Zugangsdaten (MEDIEN_*, GITHUB_TOKEN) – nie committen
.env
.env.*

# Von build-all.js erzeugte nginx-Serverblöcke für eigene Domains
nginx-domains.conf

# Weitere Arbeitsordner (git worktree) für parallele Claude-Sessions, z. B. .worktrees/nora
.worktrees/
