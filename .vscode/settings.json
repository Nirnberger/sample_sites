      "fileMatch": ["vorlagen/*/salon.json", "vorlagen/*/barber.json", "vorlagen/*/cafe.json", "vorlagen/*/shop.json",
                    "kunden/*/salon.json", "kunden/*/barber.json", "kunden/*/cafe.json", "kunden/*/shop.json"],
